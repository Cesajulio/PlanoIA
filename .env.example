# Chave da API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/apikey)
# Se deixar vazio, o sistema funcionará automaticamente no Modo Demonstração Local.
GEMINI_API_KEY=

# Modelo Gemini utilizado (padrão recomendado: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Porta do servidor web local
PORT=8000
