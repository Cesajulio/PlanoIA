{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=/api/$1"
    },
    {
      "source": "/docs",
      "destination": "/api/index?__path=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index?__path=/openapi.json"
    }
  ]
}
